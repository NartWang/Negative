# 复制为 .env 后填写；API Key 只保存在本地，不要提交到 Git。
# 图片生成优先使用 IMAGE_API_KEYS；IMAGE_API_KEY 仅作 legacy fallback。
# 缺失配置时接口会返回 503，不会尝试发起外部请求。

# 日记 Agent（OpenAI-compatible chat completions，纯文本即可）
# 填写支持下述模型的 OpenAI-compatible endpoint。
DIARY_API_BASE_URL=
DIARY_API_KEY=
DIARY_MODEL=claude-opus-4-6

# 可选：给显式请求描述的日记照片生成一句描述的多模态模型。
# 留空时复用 DIARY_MODEL；普通上传、头像和角色照片不会发送给视觉模型。
VISION_MODEL=

# 绘图 Agent（OpenAI-compatible image generations）
IMAGE_API_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
IMAGE_API_KEYS=
# 仅作 IMAGE_API_KEYS 缺失或为空时的 legacy fallback。
IMAGE_API_KEY=
IMAGE_MODEL=qwen-image-2512-lightning

# 由授权照片生成 Q 版像素角色母版的模型。必须支持 OpenAI 兼容的
# /images/edits 端点（例如 gpt-image-1）。留空则回退到 IMAGE_MODEL。
# 注意：部分共享代理有 60s 网关超时，high 画质常超时，建议 medium。
CHARACTER_IMAGE_MODEL=
CHARACTER_IMAGE_QUALITY=medium

# 媒体保护（默认最大 10 MiB；私有/回环地址下载默认关闭）
MEDIA_MAX_BYTES=10485760
MEDIA_ALLOW_PRIVATE_HOSTS=false

# 绘本视频（首尾帧接力：相邻两页配成一段，N 页得到 N-1 段，全部并行渲染后拼成一条）
# 留空则「生成漫剧」接口返回 503，不会尝试发起外部请求。
VIDEO_API_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
VIDEO_API_KEY=
VIDEO_MODEL=doubao-seedance-2-5-260628
# 每段时长（3~12秒）。各段必须一致，否则成片节奏会一顿一顿。
VIDEO_SEGMENT_DURATION=5
# adaptive 沿用首帧比例，绘本页不会被裁掉两边。
VIDEO_RATIO=adaptive
# 所有段共用同一 seed，压住跨段画风漂移；<=0 表示交给模型随机。
VIDEO_SEED=0
# 上游对视频任务有并发配额，触发限流就调小。
VIDEO_MAX_CONCURRENCY=3
# 接缝有色差跳变时调到 0.15，加一段短交叉溶解遮一下。
VIDEO_XFADE_SECONDS=0
# 视频成片体积上限（默认 96 MiB）。
VIDEO_MAX_BYTES=100663296
# 拼接需要 ffmpeg；留空则在 PATH 与 imageio-ffmpeg 自带二进制里自动查找。
FFMPEG_BIN=
ZHIJI_VIDEO_DIR=./data/videos

# 本地服务配置。线上 HTTPS 必须设为 true；本地 http://localhost 使用 false。
ZHIJI_DB_PATH=./data/zhiji.db
ZHIJI_UPLOAD_DIR=./data/uploads
FRONTEND_ORIGINS=http://localhost:3000
SESSION_COOKIE_SECURE=false
SESSION_TTL_SECONDS=2592000
HOST=127.0.0.1
PORT=8000

# 公开注册开关。本地开发默认 true；对外 Demo 部署时设为 false，
# 只放行你预建的体验账号登录，防止陌生人注册后占用记录/生成资源。
REGISTRATION_OPEN=true
